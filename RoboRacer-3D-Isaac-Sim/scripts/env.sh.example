# Data roots. Copy to scripts/env.sh (git-ignored), adjust DATA_DRIVE_ROOT, then `source scripts/env.sh`.
#
# Fast local copies (checkpoints, poses, CSVs, scenes; no raw bags/videos) live in
# data/local/ (git-ignored). The full ~65 GB project working directory stays on
# the Samsung T7 drive under DATA_DRIVE_ROOT and is only needed for raw data.
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export DATA_DRIVE_ROOT="/media/alienware_felix/T7/roboracer_data"
export LOCAL_DATA="$REPO_ROOT/data/local"

# vehicle dynamics 20 ms CSVs (Day1/Day2/Day3 + 2026-08-27) and all training runs
export DATA_DIR="$LOCAL_DATA/processed_data"
export DYNAMICS_TRAINED_MODELS="$LOCAL_DATA/dynamics_trained_models"
export DYNAMICS_WORKDIR="$DATA_DRIVE_ROOT/Zusammenfassung/5_MSNN_for_Lab/Code von Felix/ma_jonathanmohr-main"

# 2026-07-14 recording (camera 27.61 dB + LiDAR 13.44 cm checkpoints, transforms.json, scene.usda)
export NEW1_ROOT="$LOCAL_DATA/New1"
export CAMERA_3DGS_CONFIG="$NEW1_ROOT/checkpoints/camera_3dgs_flat/config.yml"   # floor-flattened fine-tune (scripts/flatten_floor.py); original: checkpoints/camera_3dgs/config.yml
export LIDAR_3DGS_CKPT="$NEW1_ROOT/checkpoints/lidar_3dgs/best_flat.pt"   # floor-flattened; original: best.pt
export ISAAC_SCENE_POINTS="$NEW1_ROOT/scene_splat_points.usda"   # baked 3DGS as USD points (scripts/splat_to_usd_points.py)
export ISAAC_SCENE_GSPLAT="$NEW1_ROOT/scene_splat_gsplat_flat.usd"   # native 3DGS prim, Isaac Sim >= 6 only (scripts/splat_to_usd_gsplat.py)

# legacy Probe root (vocab tree + Isaac Sim export meshes only)
export PROBE_ROOT="$LOCAL_DATA/Probe"
export VOCAB_TREE="$PROBE_ROOT/colmap_undistort/vocab_tree.bin"

# newest sessions (checkpoints, COLMAP poses, USD scenes; raw bags/videos only on the drive)
export SESSION_142014="$LOCAL_DATA/sessions/session_20260827_142014_noflare"
export SESSION_143212="$LOCAL_DATA/sessions/session_20260827_143212_noflare"
export SESSION_ZHUITONG="$LOCAL_DATA/sessions/session_20260904_161841_zhuitong"
export RAW_SESSION_142014="$DATA_DRIVE_ROOT/27.08新赛道和Dynamik/3dgs session_20260827_142014"
export RAW_SESSION_143212="$DATA_DRIVE_ROOT/27.08新赛道和Dynamik/dynamik session_20260827_143212"
export RAW_SESSION_ZHUITONG="$DATA_DRIVE_ROOT/07,09,2026 New 3DGS/zhui tong session_20260904_161841"
export NEW_PIPELINE_SCRIPTS="$LOCAL_DATA/pipeline_scripts_1707"

export WANDB_MODE="${WANDB_MODE:-offline}"
export PYTHONNOUSERSITE=1
# nerfstudio 1.1.5 checkpoints need this under torch 2.6 (also set on the conda env itself)
export TORCH_FORCE_NO_WEIGHTS_ONLY_LOAD=1

# 3DGRUT (NVIDIA) retrain of session 142014_noflare, NuRec-style asset (scripts/train_3dgrut.sh + build_3dgrut_scene.sh)
export RUNS_DIR="/media/alienware_felix/T7/roboracer_runs"
export ISAAC_SCENE_3DGRUT="$SESSION_142014/scene_3dgrut.usda"
export TRAJ_3DGRUT="$SESSION_142014/scene_3dgrut_trajectory.json"
export OBJECTS_DIR="$LOCAL_DATA/objects"   # object splats for opponents (scripts/import_object_splat.py)
